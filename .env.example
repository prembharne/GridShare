# ── GridShare backend — demo/production environment ──
# For a crash-free DEMO, the only thing you must set is PORT (Railway sets it
# automatically). Everything else has safe defaults and the app runs fully
# in-memory (no database) when GRIDSHARE_PERSIST is false.

# Railway injects PORT automatically; do not hardcode it there.
PORT=8080

# Persistence — leave false for the demo (in-memory, cannot crash on DB).
# Set true ONLY when DATABASE_URL points at a real Postgres AND the Prisma
# client has been generated (postinstall handles that).
GRIDSHARE_PERSIST=false
# DATABASE_URL=postgresql://user:pass@host:5432/gridshare

# Use mock chain/hardware/payment adapters for the demo.
GRIDSHARE_USE_REAL_ADAPTERS=false

# Razorpay (UPI top-up). Test keys are fine for the demo.
RAZORPAY_KEY_ID=rzp_test_TF2vRTHMmIUlO3
RAZORPAY_KEY_SECRET=5HjlT2I6eWxK0oTnVuV88jQT
# RAZORPAY_WEBHOOK_SECRET=

# Stellar USDC on-ramp (testnet). Leave STELLAR_USDC_ENABLED=false to disable.
STELLAR_USDC_ENABLED=false
