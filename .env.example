# GridShare Difficult Core - Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# CORE SETTINGS
# ============================================
PORT=8080
GRIDSHARE_DEMO_MODE=true
GRIDSHARE_DEMO_STEP_DELAY_MS=500
GRIDSHARE_REQUEST_BODY_LIMIT_BYTES=1048576

# ============================================
# DATABASE (PostgreSQL + TimescaleDB + PostGIS)
# ============================================
DATABASE_URL=postgres://gridshare:gridshare_dev_password@localhost:5432/gridshare

# Enable real adapters (requires all real adapter configs below)
GRIDSHARE_USE_REAL_ADAPTERS=false

# ============================================
# RETRY POLICY
# ============================================
GRIDSHARE_ADAPTER_RETRY_ATTEMPTS=2
GRIDSHARE_ADAPTER_RETRY_BASE_DELAY_MS=500

# ============================================
# PRICING (in whole credits; 1 credit = 1 INR)
# ============================================
GRIDSHARE_PRICE_PER_KWH_CREDITS=18
GRIDSHARE_SERVICE_FEE_BPS=300

# ============================================
# SAFETY THRESHOLDS (16A BIS plug)
# ============================================
GRIDSHARE_MAX_CURRENT_AMP=16
GRIDSHARE_MAX_TEMP_C=70
GRIDSHARE_MIN_VOLTAGE_V=180
GRIDSHARE_MAX_VOLTAGE_V=260

# ============================================
# EVENT LOGGING (JSONL audit trail)
# ============================================
GRIDSHARE_EVENT_LOG_PATH=runtime/events.jsonl

# ============================================
# ADMIN API KEY (guards /admin/* endpoints)
# ============================================
GRIDSHARE_ADMIN_API_KEY=changeme

# ============================================
# REAL ADAPTERS - Razorpay
# ============================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ============================================
# REAL ADAPTERS - Tuya IoT (16A Smart Plug)
# ============================================
TUYA_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
TUYA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TUYA_ENDPOINT=https://openapi.tuyacn.com
TUYA_DEVICE_ID=xxxxxxxxxxxxxxxxxxxx
TUYA_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ============================================
# REAL ADAPTERS - Stellar / Soroban
# ============================================
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_CONTRACT_ID=CAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STELLAR_RELAYER_SECRET_KEY=Sxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STELLAR_TOKEN_ADDRESS no longer required (credits are native to contract)
# STELLAR_TOKEN_UNITS_PER_PAISE no longer required
# Map backend ids (rider_demo, host_demo, ...) to custodial Stellar addresses
STELLAR_ADDRESS_MAP={"rider_demo":"G...","host_demo":"G...","*":"G..."}

# ============================================
# USDC-on-Stellar top-up rail (testnet only)
# Set STELLAR_USDC_ENABLED=true to activate.
# Requires a funded testnet account with a USDC trustline.
# Run: node scripts/setup-usdc-testnet.mjs to fund + establish trustline.
# ============================================
STELLAR_USDC_ENABLED=false
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Testnet USDC issuer (Circle's testnet issuer — do NOT use in mainnet)
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_USDC_ASSET_CODE=USDC
# The receiving account keypair (generated by setup-usdc-testnet.mjs)
STELLAR_USDC_RECEIVE_PUBLIC=Gxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STELLAR_USDC_RECEIVE_SECRET=Sxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# How long a pending deposit intent is valid (seconds; default 900 = 15 min)
GRIDSHARE_USDC_INTENT_TTL_SECONDS=900

# ============================================
# FX Rate (USD→INR for USDC credit quoting)
# ============================================
# Live rate source (free tier; no API key required)
GRIDSHARE_FX_RATE_URL=https://open.er-api.com/v6/latest/USD
# Cache TTL in seconds (default 3600 = 1 hour)
GRIDSHARE_FX_CACHE_TTL_SECONDS=3600
# Fallback rate used when the live provider is unreachable (INR per USD)
GRIDSHARE_USDC_FALLBACK_RATE=95

# ============================================
# TextBee SMS Gateway (real OTP delivery)
# Leave blank to use dev mode (OTP logged/returned, not texted).
# ============================================
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
# OTP validity window in seconds (default 300 = 5 min)
GRIDSHARE_OTP_TTL_SECONDS=300

# ============================================
# DEVELOPMENT (docker-compose defaults)
# ============================================
# POSTGRES: postgres://gridshare:gridshare_dev_password@localhost:5432/gridshare
# REDIS: redis://localhost:6379