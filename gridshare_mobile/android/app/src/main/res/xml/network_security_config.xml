<?xml version="1.0" encoding="utf-8"?>
<!--
  Permit cleartext (plain HTTP) traffic ONLY to local development hosts so the
  app can reach the backend at http://10.0.2.2:8080 from the Android emulator.
  All other domains keep the platform default (HTTPS enforced). Do not add
  production hosts here.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator alias for the host machine's localhost -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Physical device / direct localhost testing -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
